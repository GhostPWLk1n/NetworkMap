{
  "name": "network-map-app",
  "version": "1.45.0",
  "description": "Учёт компьютеров/устройств и планов размещения",
  "main": "src/main/index.js",
  "author": "Pavel Fomin",
  "license": "MIT",
  "homepage": "https://github.com/GhostPWLk1n/NetworkMap.git",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "konva": "^10.3.1",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "local.networkmap.app",
    "productName": "NetworkMap",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "portable": { "artifactName": "${productName}-${version}-portable.${ext}" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
