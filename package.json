{
  "name": "network-map-app",
  "version": "1.50.0",
  "description": "Учёт компьютеров/устройств и планов размещения",
  "main": "src/main/index.js",
  "author": "Pavel Fomin",
  "license": "MIT",
  "homepage": "https://github.com/GhostPWLk1n/NetworkMap.git",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "start": "electron .",
    "test:invoices": "node tests/invoice-parser.test.js && node tests/invoices-db.test.js",
    "test:bitrix": "node tests/bitrix.test.js && node tests/bitrix-setup.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "konva": "^10.3.1",
    "pdfjs-dist": "5.4.530",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "local.networkmap.app",
    "productName": "NetworkMap",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types,wasm,iccs}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.{map,d.mts,d.ts}",
      "!node_modules/pdfjs-dist/legacy/build/{pdf.min.mjs,pdf.worker.min.mjs,pdf.sandbox*.mjs}",
      "!node_modules/@napi-rs/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "portable": { "artifactName": "${productName}-${version}-portable.${ext}" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
