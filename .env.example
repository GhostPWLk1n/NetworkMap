# Скопируйте этот файл в .env рядом с docker-compose.yml и подставьте свой ключ.
# Сгенерировать:  openssl rand -hex 24
# Этот же ключ вводится в приложении: 🗄 БД → Выделенный сервер → Ключ доступа.
# Только латинские буквы, цифры и знаки — в HTTP-заголовок нельзя положить кириллицу.
NM_TOKEN=замените_на_свой_ключ
